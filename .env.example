# Copy this file to ".env" (gitignored) and fill in your own values.
# Get them from Supabase: Project -> Connect -> "Session pooler".
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password
# Your own schema, so teammates don't overwrite each other's tables (e.g. m1, m2, m3)
DB_SCHEMA=m1
